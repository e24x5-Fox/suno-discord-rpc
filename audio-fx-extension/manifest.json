{
  "manifest_version": 3,
  "name": "Audio FX — Universal Sound Enhancer",
  "version": "1.0.0",
  "description": "Плавающая панель на странице: дисторшн, 3-полосный эквалайзер, ревёрб и регулировка скорости для любого audio/video на сайте.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/toggle-icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
